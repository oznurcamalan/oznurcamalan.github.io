---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { frontmatter, compiledContent } from '../data/kvkk.md';

const metin = (deger: unknown) => (typeof deger === 'string' ? deger.trim() : '');
const kacis = (deger: string) =>
  deger.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const adres = metin(frontmatter.adres);
const kep = metin(frontmatter.kep);
const giris = metin(frontmatter.giris);
const tarih = frontmatter.guncelleme ? new Date(frontmatter.guncelleme) : null;
const guncelleme =
  tarih && !Number.isNaN(tarih.valueOf())
    ? tarih.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' })
    : '';

const govde = (await compiledContent()).replaceAll('{eposta}', kacis(site.eposta));
---

<Layout title="KVKK Aydınlatma Metni" description="Kişisel verilerin işlenmesi hakkında bilgilendirme">
  <article class="okuma">
    <header class="okuma-baslik">
      <span class="etiket">Kişisel veriler</span>
      <h1>KVKK Aydınlatma Metni</h1>
    </header>
    <hr class="ayrac" />
    <div class="prose">
      {giris && <p>{giris}</p>}

      <h2>1. Veri Sorumlusunun Kimliği</h2>
      <ul>
        <li>Veri sorumlusu: {site.ad}, {site.unvan}</li>
        {adres && <li>Adres: {adres}</li>}
        {kep && <li>KEP adresi: {kep}</li>}
        <li>E-posta: {site.eposta}</li>
      </ul>

      <Fragment set:html={govde} />

      {guncelleme && (
        <>
          <h2>Güncelleme</h2>
          <p>Bu metin en son {guncelleme} tarihinde güncellenmiştir.</p>
        </>
      )}
    </div>
  </article>
</Layout>

<style>
  .okuma {
    padding-bottom: 104px;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  @media (max-width: 720px) {
    .okuma {
      padding-bottom: var(--bolum-bosluk);
    }
  }
</style>