---
import Layout from '../../layouts/Layout.astro';
import Ikon from '../../components/Ikon.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const makaleler = await getCollection('makaleler', ({ data }) => !data.draft);
  return makaleler.map((makale) => ({
    params: { slug: makale.id },
    props: { makale },
  }));
}

const { makale } = Astro.props;
const { Content } = await render(makale);
const tarih = makale.data.date;
---

<Layout title={makale.data.title} description={makale.data.description}>
  <article class="okuma">
    <a href="/makaleler" class="ok-baglanti geri">
      <Ikon ad="geri" boyut={18} /> Tüm makaleler
    </a>
    <header class="okuma-baslik">
      <time class="ikincil tarih" datetime={tarih.toISOString().slice(0, 10)}>
        {tarih.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
      <h1>{makale.data.title}</h1>
      <p class="okuma-ozet">{makale.data.description}</p>
    </header>
    <hr class="ayrac" />
    <div class="prose">
      <Content />
    </div>
  </article>

  <aside class="yazar-alan" aria-label="Yazar hakkında">
    <div class="yazar">
      {site.foto ? (
        <img class="yazar-foto" src={site.foto} alt="" width="88" height="88" loading="lazy" decoding="async" />
      ) : (
        <div class="yazar-foto yer-tutucu" aria-hidden="true">[Fotoğraf]</div>
      )}
      <div class="yazar-metin">
        <span class="yazar-ad">{site.ad}</span>
        <span class="ikincil">{site.yazarNotu}</span>
        <div class="yazar-butonlar">
          <button
            type="button"
            class="btn btn-birincil btn-kucuk"
            data-cal-link="oznurcamalan/ongorusme"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          >
            Ön Görüşme Talep Et
          </button>
          <a href="/hakkimda" class="btn btn-cerceveli btn-kucuk">Hakkımda</a>
        </div>
      </div>
    </div>
    <p class="not">Bu yazı bilgilendirme amaçlıdır; tanı ya da tedavi yerine geçmez.</p>
  </aside>
</Layout>

<style>
  .okuma {
    padding-bottom: 72px;
  }
  .geri {
    margin-bottom: 28px;
  }
  .tarih {
    font-size: 14px;
  }
  .yazar-alan {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--yan-bosluk) 104px;
  }
  .yazar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    padding: 40px;
    border-radius: 32px;
    background: var(--yulaf-koyu);
  }
  .yazar-foto {
    flex: 0 0 88px;
    width: 88px;
    height: 88px;
    border-radius: 999px;
    background: var(--pudra);
    object-fit: cover;
  }
  .yer-tutucu {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 11px;
    line-height: 1.3;
    color: var(--pudra-metin);
  }
  .yazar-metin {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .yazar-ad {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.3;
  }
  .yazar-butonlar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .not {
    margin-top: 24px;
    font-size: 14px;
    color: var(--yumusak);
  }
  @media (max-width: 720px) {
    .okuma {
      padding-bottom: 48px;
    }
    .geri {
      margin-bottom: 16px;
    }
    .yazar-alan {
      padding-bottom: var(--bolum-bosluk);
    }
    .yazar {
      gap: 20px;
      padding: 28px 24px;
      border-radius: 24px;
    }
    .yazar-metin {
      flex-basis: 100%;
    }
    .yazar-butonlar {
      flex-direction: column;
    }
    .yazar-butonlar .btn {
      width: 100%;
    }
  }
</style>
