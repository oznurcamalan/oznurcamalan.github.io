---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Hakkımda" description={`${site.ad} hakkında`}>
  <h1>Hakkımda</h1>

  <img
    src="/images/danisman.jpg"
    alt={`${site.ad}, ${site.unvan}`}
    width="320"
    height="400"
  />

  <p>Danışmanın kendini tanıttığı yazı buraya gelecek.</p>

  <h2>Eğitim</h2>
  <ul>
    <li>Üniversite, bölüm, yıl</li>
  </ul>

  <h2>Çalışma Alanları</h2>
  <ul>
    <li>Çalışma alanı</li>
  </ul>
</Layout>