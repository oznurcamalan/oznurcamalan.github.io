---
import Layout from '../layouts/Layout.astro';
import RandevuKartlari from '../components/RandevuKartlari.astro';
import { site } from '../data/site';
---

<Layout title="Randevu" description={site.seoRandevu || 'Ön görüşme ve randevu talebi'}>
  <section class="kapsayici sayfa-baslik">
    <span class="etiket">Randevu</span>
    <h1>{site.randevuBaslik}</h1>
    {site.randevuGiris && <p class="giris">{site.randevuGiris}</p>}
  </section>

  <section class="kapsayici secenekler">
    <RandevuKartlari />
  </section>
</Layout>

<style>
  .sayfa-baslik {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 56px;
    padding-bottom: 48px;
  }
  .sayfa-baslik h1 {
    max-width: 780px;
    font-size: 56px;
  }
  .sayfa-baslik .giris {
    max-width: 620px;
  }
  .secenekler {
    padding-top: 16px;
    padding-bottom: 104px;
  }
  @media (max-width: 720px) {
    .sayfa-baslik {
      gap: 16px;
      padding-top: 24px;
      padding-bottom: 32px;
    }
    .sayfa-baslik h1 {
      font-size: 38px;
    }
    .secenekler {
      padding-top: 0;
      padding-bottom: var(--bolum-bosluk);
    }
  }
</style>
