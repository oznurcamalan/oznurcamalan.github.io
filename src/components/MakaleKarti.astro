---
import type { CollectionEntry } from 'astro:content';
import Ikon from './Ikon.astro';

interface Props {
  makale: CollectionEntry<'makaleler'>;
  pudra?: boolean;
  boyut?: 'kucuk' | 'buyuk';
}

const { makale, pudra = false, boyut = 'kucuk' } = Astro.props;
const tarih = makale.data.date;
---

<a href={`/makaleler/${makale.id}`} class:list={['kart', boyut, { pudra }]}>
  <time class="tarih" datetime={tarih.toISOString().slice(0, 10)}>
    {tarih.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
  </time>
  <span class="baslik">{makale.data.title}</span>
  <span class="ozet">{makale.data.description}</span>
  {boyut === 'buyuk' && (
    <span class="oku" aria-hidden="true">
      Oku <Ikon ad="ok" boyut={18} />
    </span>
  )}
</a>

<style>
  .kart {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    border-radius: 28px;
    border: 1px solid var(--cizgi);
    background: var(--kart);
    color: var(--murekkep);
    text-decoration: none;
  }
  .kart:hover {
    color: var(--murekkep);
    border-color: var(--pudra-derin);
  }
  .kart:hover .baslik {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .tarih {
    font-size: 14px;
    color: var(--yumusak);
  }
  .baslik {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.3;
  }
  .ozet {
    color: var(--yumusak);
  }
  .buyuk {
    flex-basis: 480px;
    gap: 14px;
    padding: 40px;
  }
  .buyuk .baslik {
    font-size: 28px;
    line-height: 1.25;
  }
  .oku {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-weight: 600;
    color: var(--kil);
  }
  .pudra {
    border-color: var(--pudra);
    background: var(--pudra);
  }
  .pudra .tarih,
  .pudra .ozet {
    color: var(--pudra-metin);
  }
  .pudra .oku {
    color: var(--murekkep);
  }
  @media (max-width: 720px) {
    .kart,
    .buyuk {
      flex-basis: 100%;
      gap: 8px;
      padding: 24px;
      border-radius: 24px;
    }
    .baslik,
    .buyuk .baslik {
      font-size: 22px;
    }
  }
</style>
