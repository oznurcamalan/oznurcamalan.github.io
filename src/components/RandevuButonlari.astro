---
import { site } from '../data/site';
import Ikon from './Ikon.astro';

interface Props {
  goster?: 'ikisi' | 'ongorusme' | 'randevu';
  hizala?: 'sol' | 'orta';
  ok?: boolean;
}

const { goster = 'ikisi', hizala = 'sol', ok = false } = Astro.props;
---

<div class:list={['randevu-butonlari', { orta: hizala === 'orta' }]}>
  {goster !== 'randevu' && (
    <button
      type="button"
      class="btn btn-birincil"
      data-cal-link={site.onGorusmeLink}
      data-cal-namespace="30min"
      data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
    >
      Ön Görüşme Talep Et
      {ok && <Ikon ad="ok" boyut={18} />}
    </button>
  )}

  {goster !== 'ongorusme' && (
    <button
      type="button"
      class="btn btn-cerceveli"
      data-cal-link={site.randevuLink}
      data-cal-namespace="15min"
      data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
    >
      Randevu Talep Et
      {ok && goster === 'randevu' && <Ikon ad="ok" boyut={18} />}
    </button>
  )}
</div>

<style>
  .randevu-butonlari {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .orta {
    justify-content: center;
  }
  @media (max-width: 720px) {
    .randevu-butonlari {
      flex-direction: column;
      gap: 12px;
    }
    .randevu-butonlari .btn {
      width: 100%;
    }
  }
</style>
