---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalScript from '../components/CalScript.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${site.unvan} ${site.ad}` } = Astro.props;
const tamBaslik =
  title === 'Ana Sayfa' ? `${site.ad} | ${site.unvan}` : `${title} | ${site.ad}`;

// Sayfalar klasör olarak üretildiği için (/hakkimda/) adresler her zaman / ile biter; site haritasıyla aynı biçim.
const hataSayfasi = /^\/404(\.html|\/)?$/.test(Astro.url.pathname);
const yol = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const kanonik = new URL(yol, Astro.site).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{tamBaslik}</title>
    {!hataSayfasi && <link rel="canonical" href={kanonik} />}

    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!hataSayfasi && <meta property="og:url" content={kanonik} />}
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.ad} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={tamBaslik} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a href="#icerik" class="atla">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <CalScript />
  </body>
</html>
